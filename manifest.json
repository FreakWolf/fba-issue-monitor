{
  "manifest_version": 3,
  "name": "FBA Issue Monitor",
  "version": "1.10.4",
  "description": "Monitors unassigned Reimbursements India issues, classifies, auto-resolves, auto-assigns with polling + double-click.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://issues.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://issues.amazon.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "rules.json"
      ],
      "matches": [
        "https://issues.amazon.com/*"
      ]
    }
  ]
}